# Copy to .env. `vetskill review` reads .env from the working directory and
# never overrides variables already set in the environment.
ATMOROUTER_API_KEY=ar-your-key-here

# Optional overrides. Defaults are shown.
# VETSKILL_BASE_URL=https://atmorouter.dev/v1
# VETSKILL_MODEL=cb/glm-5.3-flash
# VETSKILL_API_STYLE=openai        # or: anthropic (POSTs to <base>/messages)
# VETSKILL_API_KEY=ar-your-key-here
# VETSKILL_TIMEOUT=90
